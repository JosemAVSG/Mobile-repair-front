# Backend desplegado (Render). Si no existe, en dev local se usa el proxy de Vite (/api -> localhost:8080)
VITE_API_URL=https://reparaciones-api.onrender.com

# Dominio que se imprime en el QR de los tickets. Fijarlo evita que los QR
# dependan del dominio desde donde se abre la app.
VITE_PUBLIC_URL=https://repair.jglabs.tech

# Correo de contacto para el plan EMPRESARIAL (botón "Contactar" en Configuración > Suscripción).
# Si está vacío se muestra un texto sin enlace.
VITE_BILLING_CONTACT_EMAIL=
